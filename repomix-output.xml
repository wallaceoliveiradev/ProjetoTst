<file path="node-portable/node-v24.19.0-win-x64/corepack">
#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*) basedir=`cygpath -w "$basedir"`;;
esac

if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/node_modules/corepack/dist/corepack.js" "$@"
else
  exec node  "$basedir/node_modules/corepack/dist/corepack.js" "$@"
fi
</file>

<file path="node-portable/node-v24.19.0-win-x64/corepack.cmd">
