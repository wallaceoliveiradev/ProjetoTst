.layout {
  display: flex;
  min-height: 100vh;
  font-family: 'Segoe UI', Roboto, Arial, sans-serif;
  background: var(--cream);
}

.sidebar {
  width: 250px;
  background: linear-gradient(180deg, var(--charcoal) 100%);
  border-right: 1px solid rgba(15, 26, 26, 0.2);
  padding: 1px 5px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  box-shadow: 2px 0 18px rgba(15, 26, 26, 0.18);
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 16px 0 28px;
  background: rgba(255, 255, 255, 0.06);
  border-bottom: 1px solid rgba(255, 255, 255, 0.25);
  margin-bottom: 24px;
}

.brand-logo {
  width: 100%;
  height: 110%;
  margin: 0;
  object-fit: contain;
}

.brand-text {
  font-size: 18px;
  font-weight: 700;
  color: var(--charcoal);
  letter-spacing: 0.02em;
}

.sidebar nav {
  flex: 1;
}

.sidebar nav ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

.sidebar nav li {
  margin-bottom: 12px;
}

.sidebar nav a {
  display: block;
  padding: 12px 16px;
  color: var(--white);
  text-decoration: none;
  border-radius: 8px;
  transition:
    background 0.2s ease,
    transform 0.2s ease,
    color 0.2s ease;
  font-weight: 600;
}

.sidebar nav a:hover {
  background: rgba(212, 175, 55, 0.14);
  transform: translateX(2px);
}

.sidebar nav a.active {
  background: linear-gradient(135deg, var(--gold), var(--gold-deep));
  color: var(--charcoal);
  font-weight: 700;
}

.sidebar-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  background: rgba(245, 240, 230, 0.95);
  border-top: 1px solid rgba(15, 26, 26, 0.12);
  padding: 10px 12px;
  min-height: 74px;
}

.profile-area {
  position: relative;
  display: flex;
  align-items: center;
  gap: 10px;
  flex: 1;
  min-width: 0;
}

.profile-avatar {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: var(--white);
  border: 3px solid var(--gold);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  margin-left: 0;
  flex-shrink: 0;
}

.profile-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.profile-text {
  display: flex;
  flex-direction: column;
  justify-content: center;
  line-height: 1.1;
}

.profile-text span {
  font-size: 0.62rem;
  color: var(--muted);
}

.profile-text strong {
  font-size: 0.95rem;
  color: var(--charcoal);
  line-height: 1.1;
}

.config-button {
