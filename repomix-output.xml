    <a routerLink="#" routerLinkActive="active">Controle de Validades</a>
  </nav>

  <div class="training-actions">
    <button class="btn-novo-treinamento" (click)="abrirFormulario()">Novo Treinamento</button>
  </div>
  @if (formularioAberto) {
    <div class="formulario-treinamento">
      <div class="formulario-header">
        <h3>{{ treinamentoEditando ? 'Editar Treinamento' : 'Novo Treinamento' }}</h3>
      </div>

      <form (ngSubmit)="salvarTreinamento()">
        <div class="form-group">
          <label for="nome">Nome do Treinamento</label>
          <input
            type="text"
            id="nome"
            [(ngModel)]="novoTreinamento.nome"
            name="nome"
            placeholder="Ex.: Direção Defensiva para Motoristas"
          />
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="norma">NR / Norma</label>
            <input
              type="text"
              id="norma"
              [(ngModel)]="novoTreinamento.norma"
              name="norma"
              placeholder="Ex.: NR-06"
            />
          </div>

          <div class="form-group">
            <label for="carga">Carga horária</label>
            <input
              type="number"
              id="carga"
              [(ngModel)]="novoTreinamento.cargaHoraria"
              name="cargaHoraria"
              placeholder="Ex.: 8"
            />
          </div>

          <div class="form-group">
            <label for="validade">Validade</label>
            <select id="validade" [(ngModel)]="novoTreinamento.validade" name="validade">
              <option value="">Selecione</option>
              <option value="6">6 meses</option>
              <option value="12">12 meses</option>
              <option value="24">24 meses</option>
              <option value="36">36 meses</option>
            </select>
          </div>

          <div class="form-group">
            <label for="participantes">Participantes</label>
            <input
              type="number"
              id="participantes"
              [(ngModel)]="novoTreinamento.participantes"
              name="participantes"
              min="0"
              placeholder="Ex.: 30"
            />
          </div>
        </div>

        <div class="form-group">
          <label for="descricao">Descrição</label>
          <textarea
            id="descricao"
            rows="4"
            [(ngModel)]="novoTreinamento.descricao"
            name="descricao"
            placeholder="Descreva o objetivo e conteúdo do treinamento"
          ></textarea>
        </div>

        <div class="form-actions">
          <button type="button" class="btn-cancelar" (click)="fecharFormulario()">Cancelar</button>
          <button type="submit" class="btn-salvar">
            {{ treinamentoEditando ? 'Salvar alterações' : 'Salvar treinamento' }}
          </button>
        </div>
      </form>
    </div>
  }

  <table>
    <thead>
      <tr>
        <th>Treinamento</th>
        <th>NR / Norma</th>
        <th>Descrição</th>
        <th>Carga horária</th>
        <th>Validade</th>
        <th>Participantes</th>
        <th>Status</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      @for (treinamento of treinamentos; track treinamento.id) {
        <tr>
          <td>{{ treinamento.nome }}</td>
          <td>{{ treinamento.norma }}</td>
          <td>{{ treinamento.descricao }}</td>
          <td>{{ treinamento.cargaHoraria }} horas</td>
          <td>{{ treinamento.validade }} meses</td>
          <td>{{ treinamento.participantes }}</td>
          <td>{{ treinamento.status }}</td>

          <td class="acoes">
            <button class="btn-ver">Ver</button>
            <button class="btn-editar" (click)="editarTreinamento(treinamento)">Editar</button>
          </td>
        </tr>
      }
    </tbody>
  </table>
</div>
