<file path="src/app/pages/riscos/riscos.ts">
import { HttpErrorResponse } from '@angular/common/http';
import { CommonModule } from '@angular/common';
import { ChangeDetectorRef, Component, OnInit } from '@angular/core';
import { FormsModule } from '@angular/forms';
import {
  NivelRiscoApi,
  RiscoApi,
  RiscoApiService,
  RiscoRequestApi,
  SituacaoRiscoApi,
} from '../../services/risco-api.service';

type NivelRiscoUi = 'Alto' | 'Médio' | 'Baixo';
type SituacaoRiscoUi = 'Ativo' | 'Inativo';

interface Risco {
  id: number;
  setor: string;
  risco: string;
  nivel: NivelRiscoUi;
  situacao: SituacaoRiscoUi;
  icone: string;
}

interface FormularioRisco {
  setor: string;
  risco: string;
  nivel: NivelRiscoUi;
  situacao: SituacaoRiscoUi;
}

const nivelParaApi: Record<NivelRiscoUi, NivelRiscoApi> = {
  Alto: 'ALTO',
  'Médio': 'MEDIO',
  Baixo: 'BAIXO',
};

const nivelDaApi: Record<NivelRiscoApi, NivelRiscoUi> = {
  ALTO: 'Alto',
  MEDIO: 'Médio',
  BAIXO: 'Baixo',
};

const situacaoParaApi: Record<SituacaoRiscoUi, SituacaoRiscoApi> = {
  Ativo: 'ATIVO',
  Inativo: 'INATIVO',
};

const situacaoDaApi: Record<SituacaoRiscoApi, SituacaoRiscoUi> = {
  ATIVO: 'Ativo',
  INATIVO: 'Inativo',
};

@Component({
  selector: 'app-riscos',
  standalone: true,
  imports: [CommonModule, FormsModule],
  templateUrl: './riscos.html',
  styleUrl: './riscos.scss',
})
export class Riscos implements OnInit {
  busca = '';
  nivelFiltro: 'Todos' | NivelRiscoUi = 'Todos';
  situacaoFiltro: 'Todos' | SituacaoRiscoUi = 'Todos';

  readonly niveis = ['Todos', 'Alto', 'Médio', 'Baixo'];
  readonly situacoes = ['Todos', 'Ativo', 'Inativo'];

  riscos: Risco[] = [];
  private todosRiscos: Risco[] = [];
  carregando = true;
  salvando = false;
  mensagemErro = '';
  mensagemSucesso = '';
  formularioAberto = false;
  editandoId: number | null = null;
  riscoVisualizado: Risco | null = null;
  formulario = this.novoFormulario();

  constructor(
    private riscoApi: RiscoApiService,
    private changeDetector: ChangeDetectorRef,
  ) {}

  ngOnInit(): void {
    this.carregarTodos();
  }

  get totalRiscos(): number {
    return this.todosRiscos.length;
  }

  get totalAltos(): number {
    return this.todosRiscos.filter((risco) => risco.nivel === 'Alto').length;
  }

  get totalMedios(): number {
    return this.todosRiscos.filter((risco) => risco.nivel === 'Médio').length;
  }

  get totalBaixos(): number {
    return this.todosRiscos.filter((risco) => risco.nivel === 'Baixo').length;
  }

  novoRisco(): void {
    this.formulario = this.novoFormulario();
    this.editandoId = null;
    this.riscoVisualizado = null;
    this.formularioAberto = true;
    this.limparMensagens();
  }

  editarRisco(risco: Risco): void {
    this.formulario = {
      setor: risco.setor,
      risco: risco.risco,
      nivel: risco.nivel,
      situacao: risco.situacao,
    };
    this.editandoId = risco.id;
    this.riscoVisualizado = null;
    this.formularioAberto = true;
    this.limparMensagens();
  }

  cancelarEdicao(): void {
    this.formularioAberto = false;
    this.editandoId = null;
    this.formulario = this.novoFormulario();
  }

  salvarRisco(): void {
    if (this.salvando) {
      return;
    }

    this.salvando = true;
    this.limparMensagens();
    const dados: RiscoRequestApi = {
      setor: this.formulario.setor.trim(),
      risco: this.formulario.risco.trim(),
      nivel: nivelParaApi[this.formulario.nivel],
      situacao: situacaoParaApi[this.formulario.situacao],
      icone: null,
    };
    const requisicao = this.editandoId === null
      ? this.riscoApi.criar(dados)
      : this.riscoApi.atualizar(this.editandoId, dados);

    requisicao.subscribe({
      next: (resposta) => {
        const risco = this.adaptar(resposta);
        this.atualizarResumo(risco);
        this.formularioAberto = false;
        this.editandoId = null;
        this.salvando = false;
        this.filtrar();
        this.mensagemSucesso = 'Risco salvo com sucesso.';
        this.changeDetector.markForCheck();
      },
      error: (erro: HttpErrorResponse) => {
        this.mensagemErro = this.mensagemDaApi(erro, 'Não foi possível salvar o risco');
        this.salvando = false;
        this.changeDetector.markForCheck();
      },
    });
  }

  verRisco(risco: Risco): void {
    this.riscoVisualizado = risco;
    this.formularioAberto = false;
  }

  alternarSituacao(risco: Risco): void {
    const dados: RiscoRequestApi = {
      setor: risco.setor,
      risco: risco.risco,
      nivel: nivelParaApi[risco.nivel],
      situacao: risco.situacao === 'Ativo' ? 'INATIVO' : 'ATIVO',
      icone: null,
    };
    this.limparMensagens();
    this.riscoApi.atualizar(risco.id, dados).subscribe({
      next: (resposta) => {
        this.atualizarResumo(this.adaptar(resposta));
        this.filtrar();
        this.mensagemSucesso = `Risco ${resposta.situacao === 'ATIVO' ? 'ativado' : 'desativado'} com sucesso.`;
        this.changeDetector.markForCheck();
      },
      error: (erro: HttpErrorResponse) => {
        this.mensagemErro = this.mensagemDaApi(erro, 'Não foi possível alterar a situação do risco');
        this.changeDetector.markForCheck();
      },
    });
  }

  filtrar(): void {
    this.limparMensagens();
    this.carregando = true;
    this.riscoApi.listar({
      busca: this.busca.trim() || undefined,
      nivel: this.nivelFiltro === 'Todos' ? undefined : nivelParaApi[this.nivelFiltro],
      situacao: this.situacaoFiltro === 'Todos'
        ? undefined
        : situacaoParaApi[this.situacaoFiltro],
    }).subscribe({
      next: (riscos) => {
        this.riscos = riscos.map((risco) => this.adaptar(risco));
        this.carregando = false;
        this.changeDetector.markForCheck();
      },
      error: (erro: HttpErrorResponse) => {
        this.mensagemErro = this.mensagemDaApi(erro, 'Não foi possível carregar os riscos');
        this.carregando = false;
        this.changeDetector.markForCheck();
      },
    });
  }

  limpar(): void {
    this.busca = '';
    this.nivelFiltro = 'Todos';
    this.situacaoFiltro = 'Todos';
    this.filtrar();
  }

  private carregarTodos(): void {
    this.carregando = true;
    this.riscoApi.listar().subscribe({
      next: (riscos) => {
        this.todosRiscos = riscos.map((risco) => this.adaptar(risco));
        this.riscos = [...this.todosRiscos];
        this.carregando = false;
        this.changeDetector.markForCheck();
      },
      error: (erro: HttpErrorResponse) => {
        this.mensagemErro = this.mensagemDaApi(erro, 'Não foi possível carregar os riscos');
        this.carregando = false;
        this.changeDetector.markForCheck();
      },
    });
  }

  private adaptar(risco: RiscoApi): Risco {
    return {
      id: risco.id,
      setor: risco.setor,
      risco: risco.risco,
      nivel: nivelDaApi[risco.nivel],
      situacao: situacaoDaApi[risco.situacao],
      icone: this.iconePorNivel(nivelDaApi[risco.nivel]),
    };
  }

  iconePorNivel(nivel: NivelRiscoUi): string {
    const icones: Record<NivelRiscoUi, string> = {
      Alto: 'bi-shield-exclamation',
      'Médio': 'bi-exclamation-triangle',
      Baixo: 'bi-shield-check',
    };
    return icones[nivel];
  }

  private atualizarResumo(risco: Risco): void {
    const indice = this.todosRiscos.findIndex((item) => item.id === risco.id);
    if (indice === -1) {
      this.todosRiscos = [...this.todosRiscos, risco];
      return;
    }
    this.todosRiscos = this.todosRiscos.map((item) => item.id === risco.id ? risco : item);
  }

  private novoFormulario(): FormularioRisco {
    return {
      setor: '',
      risco: '',
      nivel: 'Médio',
      situacao: 'Ativo',
    };
  }

  private limparMensagens(): void {
    this.mensagemErro = '';
    this.mensagemSucesso = '';
  }

  private mensagemDaApi(erro: HttpErrorResponse, contexto: string): string {
    if (erro.status === 0) {
      return `${contexto}: API indisponível em http://localhost:8080.`;
    }
    if (erro.status === 401) {
      return `${contexto}: sessão expirada. Entre novamente.`;
    }
    if (erro.status === 403) {
      return `${contexto}: somente administradores podem gerenciar riscos.`;
    }
    return `${contexto} (HTTP ${erro.status}).`;
  }
}
</file>

<file path="src/app/pages/treinamentos/treinamentos.html">
<div class="content-wrapper">
  <header class="app-page-heading">
    <div class="app-page-heading__content">
      <span class="app-page-heading__eyebrow"><i class="bi bi-shield-check"></i> SAÚDE E SEGURANÇA DO TRABALHO</span>
      <h1 class="app-page-heading__title">Treinamentos</h1>
      <p class="app-page-heading__description">
        Gerencie capacitações, certificados, reciclagens e validade por colaborador.
      </p>
    </div>
  </header>

  <nav class="training-sub-nav" aria-label="Navegação de treinamentos">
    <button type="button" [class.active]="abaAtiva === 'cadastrados'" (click)="selecionarAba('cadastrados')">
      Treinamentos cadastrados
    </button>
    <button
      *ngIf="authService.isAdmin()"
      type="button"
      [class.active]="abaAtiva === 'novo'"
      (click)="abrirFormulario()"
    >
      Novo treinamento
    </button>
    <button type="button" [class.active]="abaAtiva === 'certificados'" (click)="selecionarAba('certificados')">
      Certificados
    </button>
    <button type="button" [class.active]="abaAtiva === 'reciclagens'" (click)="selecionarAba('reciclagens')">
      Reciclagens obrigatórias
      @if (registrosEmReciclagem.length > 0) {
        <span class="nav-count">{{ registrosEmReciclagem.length }}</span>
      }
    </button>
    <button type="button" [class.active]="abaAtiva === 'validades'" (click)="selecionarAba('validades')">
      Controle de validades
    </button>
  </nav>

  @if (mensagemErro) {
    <p class="error-message" role="alert">{{ mensagemErro }}</p>
  }
  @if (mensagemSucesso) {
    <p class="success-message" role="status">{{ mensagemSucesso }}</p>
  }

  @if (abaAtiva === 'novo') {
    <section class="formulario-treinamento">
      <div class="formulario-header">
        <div>
          <h2>{{ treinamentoEditando ? 'Editar treinamento' : 'Novo treinamento' }}</h2>
          <p>Cadastre o curso e relacione os colaboradores que devem realizá-lo.</p>
        </div>
      </div>

      <form #formTreinamento="ngForm" (ngSubmit)="salvarTreinamento(formTreinamento)">
        <div class="form-row">
          <div class="form-group">
            <label for="nome">Nome do treinamento</label>
            <input
              type="text"
              id="nome"
              [(ngModel)]="novoTreinamento.nome"
              name="nome"
              placeholder="Ex.: Trabalho em Altura"
              maxlength="80"
              required
            />
          </div>
          <div class="form-group">
            <label for="norma">NR / Norma</label>
            <input
              type="text"
              id="norma"
              [(ngModel)]="novoTreinamento.norma"
              (ngModelChange)="sugerirValidadeNorma()"
              name="norma"
              placeholder="Ex.: NR-35"
              required
            />
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="carga">Carga horária padrão (horas)</label>
            <input
              type="number"
              id="carga"
              [(ngModel)]="novoTreinamento.cargaHoraria"
              name="cargaHoraria"
              min="1"
              required
            />
          </div>
          <div class="form-group">
            <label for="validade">Validade padrão</label>
            <select id="validade" [(ngModel)]="novoTreinamento.validade" name="validade" required>
              <option [ngValue]="0" disabled>Selecione a validade</option>
              <option [ngValue]="6">6 meses</option>
              <option [ngValue]="12">12 meses</option>
              <option [ngValue]="24">24 meses</option>
              <option [ngValue]="36">36 meses</option>
            </select>
          </div>
          <div class="form-group">
            <label for="participantes">Participantes previstos</label>
            <input
              type="number"
              id="participantes"
              [(ngModel)]="novoTreinamento.participantes"
              name="participantes"
              min="0"
              required
            />
          </div>
        </div>

        <div class="form-group">
          <label for="descricao">Descrição / conteúdo de referência</label>
          <textarea
            id="descricao"
            rows="3"
            [(ngModel)]="novoTreinamento.descricao"
            name="descricao"
            maxlength="255"
            required
          ></textarea>
        </div>

        <div class="form-group">
          <span class="form-label">Colaboradores relacionados</span>
          @if (colaboradoresAtivos.length === 0) {
            <p class="empty-message">Nenhum colaborador ativo encontrado.</p>
          }
          <div class="collaborator-list">
            @for (colaborador of colaboradoresAtivos; track colaborador.id) {
              <label class="colaborador-option">
                <input
                  type="checkbox"
                  [checked]="novoTreinamento.usuarioIds?.includes(colaborador.id) || false"
                  (change)="alternarColaborador(colaborador.id, $event)"
                />
                <span>{{ colaborador.nome }} <small>{{ colaborador.email }}</small></span>
              </label>
            }
          </div>
        </div>

        <div class="form-actions">
          <button type="button" class="btn-cancelar" (click)="fecharFormulario()" [disabled]="salvando">
            Cancelar
          </button>
          <button type="submit" class="btn-salvar" [disabled]="salvando">
            {{ salvando ? 'Salvando...' : (treinamentoEditando ? 'Salvar alterações' : 'Salvar treinamento') }}
          </button>
        </div>
      </form>
    </section>
  }

  @if (abaAtiva === 'cadastrados') {
    <section class="section-heading">
      <div>
        <h2>Treinamentos cadastrados</h2>
        <p>Cursos disponíveis e colaboradores relacionados.</p>
      </div>
    </section>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Treinamento</th>
            <th>Norma</th>
            <th>Carga horária</th>
            <th>Validade padrão</th>
            <th>Colaboradores relacionados</th>
            <th>Status</th>
            @if (authService.isAdmin()) { <th>Ações</th> }
          </tr>
        </thead>
        <tbody>
          @for (treinamento of treinamentos(); track treinamento.id) {
            <tr>
              <td><strong>{{ treinamento.nome }}</strong><small class="cell-secondary">{{ treinamento.descricao }}</small></td>
              <td>{{ treinamento.norma }}</td>
              <td>{{ treinamento.cargaHoraria }} h</td>
              <td>{{ treinamento.validade }} meses</td>
              <td>
                @if ((treinamento.usuarioIds ?? []).length === 0) {
                  <span class="muted">Nenhum relacionado</span>
                } @else {
                  <div class="related-users">
                    @for (usuarioId of (treinamento.usuarioIds ?? []); track usuarioId) {
                      <span>{{ colaboradorDoId(usuarioId) }}</span>
                    }
                  </div>
                }
              </td>
              <td>{{ treinamento.status }}</td>
              @if (authService.isAdmin()) {
                <td><button type="button" class="btn-editar" (click)="editarTreinamento(treinamento)">Editar</button></td>
              }
            </tr>
          }
          @if (treinamentos().length === 0) {
            <tr><td [attr.colspan]="authService.isAdmin() ? 7 : 6" class="empty-message">Nenhum treinamento cadastrado.</td></tr>
          }
        </tbody>
      </table>
    </div>
  }

  @if (abaAtiva === 'certificados') {
    @if (authService.isAdmin()) {
      <section class="formulario-treinamento">
        <div class="formulario-header">
          <div>
            <h2>Registrar conclusão / reciclagem</h2>
            <p>O certificado é obrigatório. A validade e o vencimento são calculados pela regra do treinamento e cargo.</p>
          </div>
        </div>
        <form #formConclusao="ngForm" (ngSubmit)="registrarConclusao(formConclusao)">
          <div class="form-row">
            <div class="form-group">
              <label for="cursoConclusao">Treinamento</label>
              <select
                id="cursoConclusao"
                [(ngModel)]="conclusao.treinamentoId"
                (ngModelChange)="selecionarTreinamentoDaConclusao($event)"
                name="treinamentoId"
                required
              >
                <option [ngValue]="0" disabled>Selecione o treinamento</option>
                @for (treinamento of treinamentos(); track treinamento.id) {
                  <option [ngValue]="treinamento.id">{{ treinamento.norma }} — {{ treinamento.nome }}</option>
                }
              </select>
            </div>
            <div class="form-group">
              <label for="colaboradorConclusao">Colaborador</label>
              <select id="colaboradorConclusao" [(ngModel)]="conclusao.usuarioId" name="usuarioId" required>
                <option [ngValue]="0" disabled>Selecione o colaborador</option>
                @for (colaborador of colaboradoresAtivos; track colaborador.id) {
                  <option [ngValue]="colaborador.id">{{ colaborador.nome }} — {{ colaborador.cargo || 'Cargo não informado' }}</option>
                }
              </select>
            </div>
            <div class="form-group">
              <label for="dataConclusao">Data de conclusão</label>
              <input id="dataConclusao" type="date" [(ngModel)]="conclusao.dataConclusao" name="dataConclusao" required />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="cargaConclusao">Carga horária realizada (horas)</label>
              <input id="cargaConclusao" type="number" min="1" [(ngModel)]="conclusao.cargaHoraria" name="cargaHoraria" required />
            </div>
            <div class="form-group">
              <label for="instrutor">Instrutor</label>
              <input id="instrutor" type="text" maxlength="120" [(ngModel)]="conclusao.instrutor" name="instrutor" required />
            </div>
          </div>
          <div class="form-group">
            <label for="conteudoProgramatico">Conteúdo programático</label>
            <textarea
              id="conteudoProgramatico"
              rows="3"
              maxlength="4000"
              [(ngModel)]="conclusao.conteudoProgramatico"
              name="conteudoProgramatico"
              required
            ></textarea>
          </div>
          <div class="form-group">
            <label for="certificado">Certificado (PDF ou imagem, até 10 MB)</label>
            <input
              id="certificado"
              type="file"
              accept=".pdf,image/png,image/jpeg,image/gif,image/bmp,image/webp"
              (change)="selecionarCertificado($event)"
              required
            />
            @if (arquivoCertificado) { <small>Arquivo selecionado: {{ arquivoCertificado.name }}</small> }
          </div>
          <div class="form-actions">
            <button type="submit" class="btn-salvar" [disabled]="salvando">
              {{ salvando ? 'Registrando...' : 'Registrar certificado' }}
            </button>
          </div>
        </form>
      </section>
    }

    <section class="section-heading">
      <div>
        <h2>Histórico de certificados</h2>
        <p>Os ciclos anteriores são preservados quando uma reciclagem é registrada.</p>
      </div>
    </section>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Treinamento</th>
            <th>Colaborador</th>
            <th>Conclusão</th>
            <th>Vencimento</th>
            <th>Instrutor</th>
            <th>Status</th>
            <th>Certificado</th>
            @if (authService.isAdmin()) { <th>Ações preventivas</th> }
          </tr>
        </thead>
        <tbody>
          @for (registro of historico(); track registro.id) {
            <tr>
              <td><strong>{{ registro.norma }} — {{ registro.treinamentoNome }}</strong></td>
              <td>{{ registro.colaboradorNome }}</td>
              <td>{{ formatarData(registro.dataConclusao) }}</td>
              <td>{{ formatarData(registro.dataVencimento) }}</td>
              <td>{{ registro.instrutor }}</td>
              <td><span class="status-badge" [ngClass]="'status-' + registro.status.toLowerCase()">{{ statusLabel(registro.status) }}</span></td>
              <td><button type="button" class="btn-link" (click)="abrirCertificado(registro)">{{ registro.certificadoNome }}</button></td>
              @if (authService.isAdmin()) {
                <td>
                  @if (registro.status !== 'SUBSTITUIDO' && registro.status !== 'INVALIDADO') {
                    @if (cicloParaInvalidarId !== registro.id) {
                      <button type="button" class="btn-danger" (click)="iniciarInvalidacao(registro.id)">Forçar reciclagem</button>
                    } @else {
                      <form #confirmarCertificado="ngForm" (ngSubmit)="forcarReciclagem(confirmarCertificado)">
                        <label [for]="'motivoCertificado' + registro.id">Motivo</label>
                        <input [id]="'motivoCertificado' + registro.id" name="motivoCertificado" [(ngModel)]="motivoInvalidacao" maxlength="500" required />
                        <button type="submit" class="btn-danger" [disabled]="salvando">Invalidar ciclo</button>
                        <button type="button" class="btn-cancelar" (click)="cancelarInvalidacao()">Cancelar</button>
                      </form>
                    }
                  }
                </td>
              }
            </tr>
          }
          @if (historico().length === 0) {
            <tr><td [attr.colspan]="authService.isAdmin() ? 8 : 7" class="empty-message">Nenhum certificado registrado.</td></tr>
          }
        </tbody>
      </table>
    </div>
  }

  @if (abaAtiva === 'reciclagens') {
    <section class="section-heading">
      <div>
        <h2>Reciclagens obrigatórias</h2>
        <p>Alertas são atualizados automaticamente; ciclos invalidados também exigem novo certificado.</p>
      </div>
    </section>
    @if (registrosEmReciclagem.length === 0) {
      <div class="empty-state">Nenhum certificado vencido, em alerta ou invalidado.</div>
    }
    <div class="renewal-list">
      @for (registro of registrosEmReciclagem; track registro.id) {
        <article class="renewal-card" [class.renewal-expired]="registro.status === 'VENCIDO' || registro.status === 'INVALIDADO'">
          <div class="renewal-card__content">
            <span class="status-badge" [ngClass]="'status-' + registro.status.toLowerCase()">{{ statusLabel(registro.status) }}</span>
            <h3>{{ registro.norma }} — {{ registro.treinamentoNome }}</h3>
            <p><strong>Colaborador:</strong> {{ registro.colaboradorNome }} · <strong>Cargo:</strong> {{ registro.cargo || 'Não informado' }}</p>
            @if (registro.status === 'INVALIDADO') {
              <p>Este certificado foi invalidado em {{ formatarData(registro.dataInvalidacao) }}. Motivo: {{ registro.motivoInvalidacao }}.</p>
            } @else {
              <p><strong>Vencimento:</strong> {{ formatarData(registro.dataVencimento) }} · alerta com {{ registro.diasAntecedenciaAlerta }} dias de antecedência.</p>
            }
          </div>
          @if (authService.isAdmin()) {
            <div class="renewal-actions">
              <button type="button" class="btn-salvar" (click)="iniciarRenovacao(registro)">
                {{ registro.status === 'INVALIDADO' ? 'Registrar novo certificado' : 'Registrar renovação' }}
              </button>
              @if (registro.status !== 'INVALIDADO') {
                @if (cicloParaInvalidarId !== registro.id) {
                  <button type="button" class="btn-danger" (click)="iniciarInvalidacao(registro.id)">Forçar reciclagem extraordinária</button>
                } @else {
                  <form #confirmarInvalidacao="ngForm" (ngSubmit)="forcarReciclagem(confirmarInvalidacao)">
                    <label for="motivoInvalidacao">Motivo da invalidação</label>
                    <input id="motivoInvalidacao" name="motivoInvalidacao" [(ngModel)]="motivoInvalidacao" maxlength="500" required />
                    <button type="submit" class="btn-danger" [disabled]="salvando">Invalidar e exigir novo certificado</button>
                    <button type="button" class="btn-cancelar" (click)="cancelarInvalidacao()">Cancelar</button>
                  </form>
                }
              }
            </div>
          }
        </article>
      }
    </div>
  }

  @if (abaAtiva === 'validades') {
    <section class="section-heading">
      <div>
        <h2>Controle de validades</h2>
        <p>Defina regras gerais ou específicas por cargo. A regra é copiada para cada novo ciclo do certificado.</p>
      </div>
    </section>
    @if (authService.isAdmin()) {
      <section class="formulario-treinamento rule-form">
        <div class="formulario-header">
          <div>
            <h3>{{ parametroEditandoId ? 'Editar regra de validade' : 'Cadastrar regra de validade' }}</h3>
            <p>Deixe o cargo vazio para definir a regra padrão. Para NR-33, o sistema aplica 12 meses a trabalhadores/vigias e 24 meses a supervisores, salvo regra configurada.</p>
          </div>
        </div>
        @if (treinamentos().length === 0) {
          <p class="empty-message">Cadastre um treinamento antes de configurar sua validade.</p>
        } @else {
          <form #formParametro="ngForm" (ngSubmit)="salvarParametro(formParametro)">
            <div class="form-row">
              <div class="form-group">
                <label for="treinamentoRegra">Treinamento</label>
                <select id="treinamentoRegra" [(ngModel)]="parametroForm.treinamentoId" name="treinamentoId" required>
                  <option [ngValue]="0" disabled>Selecione</option>
                  @for (treinamento of treinamentos(); track treinamento.id) {
                    <option [ngValue]="treinamento.id">{{ treinamento.norma }} — {{ treinamento.nome }}</option>
                  }
                </select>
              </div>
              <div class="form-group">
                <label for="cargoRegra">Cargo (opcional)</label>
                <input id="cargoRegra" [(ngModel)]="parametroForm.cargo" name="cargo" maxlength="100" placeholder="Ex.: Supervisor de espaço confinado" />
              </div>
              <div class="form-group">
                <label for="validadeRegra">Validade (meses)</label>
                <input id="validadeRegra" type="number" min="1" max="120" [(ngModel)]="parametroForm.validadeMeses" name="validadeMeses" required />
              </div>
              <div class="form-group">
                <label for="antecedenciaRegra">Alerta antes do vencimento (dias)</label>
                <input id="antecedenciaRegra" type="number" min="0" max="365" [(ngModel)]="parametroForm.diasAntecedenciaAlerta" name="diasAntecedenciaAlerta" required />
              </div>
            </div>
            <div class="form-actions">
              <button type="button" class="btn-cancelar" (click)="novaRegraPorCargo()">Nova regra por cargo</button>
              <button type="submit" class="btn-salvar" [disabled]="salvando">{{ salvando ? 'Salvando...' : 'Salvar regra' }}</button>
            </div>
          </form>
        }
      </section>

      <section class="default-rules">
        <h3>Validade padrão dos treinamentos</h3>
        @for (treinamento of treinamentos(); track treinamento.id) {
          <article class="default-rule-row">
            <div><strong>{{ treinamento.norma }} — {{ treinamento.nome }}</strong><small>Regra geral atual: {{ treinamento.validade }} meses · alerta padrão: 60 dias</small></div>
            <button type="button" class="btn-editar" (click)="abrirRegraGeral(treinamento)">Configurar regra geral</button>
          </article>
        }
      </section>

      <section class="default-rules">
        <h3>Regras configuradas</h3>
        @for (parametro of parametros(); track parametro.id) {
          <article class="default-rule-row">
            <div>
              <strong>{{ parametro.norma }} — {{ parametro.treinamentoNome }}</strong>
              <small>{{ parametro.cargo || 'Todos os cargos' }} · {{ parametro.validadeMeses }} meses · alerta {{ parametro.diasAntecedenciaAlerta }} dias antes</small>
            </div>
            <div class="rule-actions">
              <button type="button" class="btn-editar" [disabled]="salvando" (click)="editarParametro(parametro)">Editar</button>
              <button type="button" class="btn-danger" [disabled]="salvando" (click)="excluirParametro(parametro)">Excluir</button>
            </div>
          </article>
        }
        @if (parametros().length === 0) {
          <p class="empty-message">Nenhuma regra adicional cadastrada. São aplicadas as validades padrão do treinamento e da NR-33.</p>
        }
      </section>
    }

    <section class="section-heading">
      <div>
        <h2>Certificados próximos do vencimento</h2>
        <p>O status muda automaticamente de acordo com a data atual, sem apagar o histórico.</p>
      </div>
    </section>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Treinamento</th><th>Colaborador</th><th>Data de conclusão</th><th>Data de vencimento</th><th>Validade aplicada</th><th>Status</th></tr>
        </thead>
        <tbody>
          @for (registro of historico(); track registro.id) {
            <tr>
              <td>{{ registro.norma }} — {{ registro.treinamentoNome }}</td>
              <td>{{ registro.colaboradorNome }}</td>
              <td>{{ formatarData(registro.dataConclusao) }}</td>
              <td>{{ formatarData(registro.dataVencimento) }}</td>
              <td>{{ registro.validadeAplicadaMeses }} meses</td>
              <td><span class="status-badge" [ngClass]="'status-' + registro.status.toLowerCase()">{{ statusLabel(registro.status) }}</span></td>
            </tr>
          }
          @if (historico().length === 0) {
            <tr><td colspan="6" class="empty-message">Nenhum ciclo de validade registrado.</td></tr>
          }
        </tbody>
      </table>
    </div>
  }
</div>
</file>

<file path="src/app/pages/treinamentos/treinamentos.ts">
import { CommonModule } from '@angular/common';
import { HttpErrorResponse } from '@angular/common/http';
import { Component, OnDestroy, OnInit, signal } from '@angular/core';
import { interval, Subscription } from 'rxjs';
import { FormsModule, NgForm } from '@angular/forms';
import {
  HistoricoTreinamento,
  ParametroTreinamento,
  RegistroConclusaoTreinamento,
  StatusHistoricoTreinamento,
  Treinamento,
} from './treinamento.model';
import { TreinamentoService, TreinamentoRequest } from '../../services/Treinamento.service';
import { AuthService } from '../../services/auth.service';
import { UsuarioApi, UsuarioApiService } from '../../services/usuario-api.service';

type AbaTreinamentos = 'cadastrados' | 'novo' | 'certificados' | 'reciclagens' | 'validades';

@Component({
  selector: 'app-treinamentos',
  standalone: true,
  imports: [CommonModule, FormsModule],
  templateUrl: './treinamentos.html',
  styleUrl: './treinamentos.scss',
})
export class Treinamentos implements OnDestroy, OnInit {
  constructor(
    public authService: AuthService,
    private treinamentoService: TreinamentoService,
    private usuarioApiService: UsuarioApiService,
  ) {}

  abaAtiva: AbaTreinamentos = 'cadastrados';
  salvando = false;
  treinamentoEditando: Treinamento | null = null;
  mensagemErro: string | null = null;
  mensagemSucesso: string | null = null;
  colaboradores = signal<UsuarioApi[]>([]);
  treinamentos = signal<Treinamento[]>([]);
  historico = signal<HistoricoTreinamento[]>([]);
  parametros = signal<ParametroTreinamento[]>([]);
  arquivoCertificado: File | null = null;
  cicloParaInvalidarId: number | null = null;
  motivoInvalidacao = '';
  parametroEditandoId: number | null = null;
  private atualizacaoHistorico?: Subscription;

  novoTreinamento: Treinamento = this.criarTreinamentoVazio();
  conclusao: RegistroConclusaoTreinamento = this.conclusaoVazia();
  parametroForm = {
    treinamentoId: 0,
    cargo: '',
    validadeMeses: 12,
    diasAntecedenciaAlerta: 60,
  };

  get colaboradoresAtivos(): UsuarioApi[] {
    return this.colaboradores().filter((usuario) => usuario.status === 'ATIVO');
  }

  get registrosEmReciclagem(): HistoricoTreinamento[] {
    return this.historico().filter(
      registro =>
        registro.status === 'ALERTA' ||
        registro.status === 'VENCIDO' ||
        registro.status === 'INVALIDADO',
    );
  }

  ngOnInit(): void {
    this.carregarTreinamentos();
    this.carregarHistorico();
    this.carregarParametros();
    if (this.authService.isAdmin()) {
      this.carregarColaboradores();
    }
    this.atualizacaoHistorico = interval(5 * 60 * 1000).subscribe(() => this.carregarHistorico());
  }

  ngOnDestroy(): void {
    this.atualizacaoHistorico?.unsubscribe();
  }

  selecionarAba(aba: AbaTreinamentos): void {
    if (aba === 'novo' && !this.authService.isAdmin()) {
      return;
    }
    this.abaAtiva = aba;
    this.mensagemErro = null;
    this.mensagemSucesso = null;
    if (aba === 'novo' && !this.treinamentoEditando) {
      this.novoTreinamento = this.criarTreinamentoVazio();
    }
  }

  abrirFormulario(): void {
    if (!this.authService.isAdmin()) {
      return;
    }
    this.treinamentoEditando = null;
    this.novoTreinamento = this.criarTreinamentoVazio();
    this.selecionarAba('novo');
    if (this.colaboradores().length === 0) {
      this.carregarColaboradores();
    }
  }

  fecharFormulario(): void {
    this.treinamentoEditando = null;
    this.novoTreinamento = this.criarTreinamentoVazio();
    this.selecionarAba('cadastrados');
  }

  salvarTreinamento(formulario: NgForm): void {
    if (!this.authService.isAdmin() || this.salvando) {
      return;
    }
    if (
      formulario.invalid ||
      this.novoTreinamento.validade < 1 ||
      this.novoTreinamento.cargaHoraria < 1 ||
      this.novoTreinamento.participantes < 0
    ) {
      formulario.control.markAllAsTouched();
      this.mensagemErro = 'Preencha os campos obrigatórios e selecione uma validade.';
      return;
    }
    if (this.treinamentoEditando) {
      this.atualizarTreinamento();
    } else {
      this.criarTreinamento();
    }
  }

  criarTreinamento(): void {
    if (!this.authService.isAdmin()) {
      return;
    }
    this.salvando = true;
    this.limparMensagens();
    this.treinamentoService.criar(this.obterDadosTreinamento()).subscribe({
      next: (treinamento) => {
        this.treinamentos.update((treinamentos) => [...treinamentos, treinamento]);
        this.mensagemSucesso = 'Treinamento salvo com sucesso.';
        this.salvando = false;
        this.fecharFormulario();
        this.mensagemSucesso = 'Treinamento salvo com sucesso.';
      },
      error: (erro: HttpErrorResponse) => this.finalizarErro(erro, 'salvar o treinamento'),
    });
  }

  atualizarTreinamento(): void {
    const treinamento = this.treinamentoEditando;
    if (!this.authService.isAdmin() || !treinamento) {
      return;
    }
    this.salvando = true;
    this.limparMensagens();
    this.treinamentoService.atualizar(treinamento.id, this.obterDadosTreinamento()).subscribe({
      next: (atualizado) => {
        this.treinamentos.update((lista) =>
          lista.map((item) => (item.id === atualizado.id ? atualizado : item)),
        );
        this.fecharFormulario();
        this.mensagemSucesso = 'Treinamento atualizado com sucesso.';
        this.salvando = false;
      },
      error: (erro: HttpErrorResponse) => this.finalizarErro(erro, 'atualizar o treinamento'),
    });
  }

  editarTreinamento(treinamento: Treinamento): void {
    if (!this.authService.isAdmin()) {
      return;
    }
    this.treinamentoEditando = treinamento;
    this.novoTreinamento = { ...treinamento, usuarioIds: [...(treinamento.usuarioIds ?? [])] };
    this.abaAtiva = 'novo';
    if (this.colaboradores().length === 0) {
      this.carregarColaboradores();
    }
  }

  alternarColaborador(usuarioId: number, evento: Event): void {
    const elemento = evento.currentTarget;
    if (!(elemento instanceof HTMLInputElement)) {
      return;
    }
    const selecionados = new Set(this.novoTreinamento.usuarioIds ?? []);
    if (elemento.checked) {
      selecionados.add(usuarioId);
    } else {
      selecionados.delete(usuarioId);
    }
    this.novoTreinamento.usuarioIds = [...selecionados];
  }

  sugerirValidadeNorma(): void {
    if (this.novoTreinamento.validade > 0) {
      return;
    }
    const norma = this.novoTreinamento.norma.replace(/\s/g, '').toUpperCase();
    if (norma === 'NR-10' || norma === 'NR10' || norma === 'NR-35' || norma === 'NR35') {
      this.novoTreinamento.validade = 24;
    } else if (norma === 'NR-33' || norma === 'NR33') {
      this.novoTreinamento.validade = 12;
    }
  }

  colaboradorDoId(id: number): string {
    return this.colaboradores().find((usuario) => usuario.id === id)?.nome ?? `Colaborador #${id}`;
  }

  selecionarTreinamentoDaConclusao(id: number): void {
    const treinamento = this.treinamentos().find((item) => item.id === Number(id));
    if (treinamento) {
      this.conclusao.cargaHoraria = treinamento.cargaHoraria;
      this.conclusao.conteudoProgramatico = treinamento.descricao;
    }
  }

  selecionarCertificado(evento: Event): void {
    const elemento = evento.currentTarget;
    if (!(elemento instanceof HTMLInputElement)) {
      return;
    }
    this.arquivoCertificado = elemento.files?.[0] ?? null;
  }

  registrarConclusao(formulario: NgForm): void {
    if (!this.authService.isAdmin() || this.salvando) {
      return;
    }
    if (
      !this.arquivoCertificado ||
      formulario.invalid ||
      this.conclusao.treinamentoId <= 0 ||
      this.conclusao.usuarioId <= 0 ||
      this.conclusao.cargaHoraria < 1
    ) {
      formulario.control.markAllAsTouched();
      this.mensagemErro = this.arquivoCertificado
        ? 'Preencha todos os dados obrigatórios da conclusão.'
        : 'Anexe o certificado em PDF ou imagem para registrar a conclusão.';
      return;
    }
    this.salvando = true;
    this.limparMensagens();
    this.treinamentoService.registrarConclusao(this.conclusao, this.arquivoCertificado).subscribe({
      next: () => {
        this.salvando = false;
        this.conclusao = this.conclusaoVazia();
        this.arquivoCertificado = null;
        if (typeof document !== 'undefined') {
          const seletor = document.getElementById('certificado');
          if (seletor instanceof HTMLInputElement) {
            seletor.value = '';
          }
        }
        formulario.resetForm(this.conclusao);
        this.carregarHistorico();
        this.mensagemSucesso = 'Conclusão registrada. O vencimento foi calculado e o ciclo anterior preservado.';
      },
      error: (erro: HttpErrorResponse) => this.finalizarErro(erro, 'registrar a conclusão'),
    });
  }

  iniciarRenovacao(registro: HistoricoTreinamento): void {
    this.conclusao = {
      treinamentoId: registro.treinamentoId,
      usuarioId: registro.usuarioId,
      dataConclusao: new Date().toISOString().slice(0, 10),
      cargaHoraria: this.treinamentos().find((item) => item.id === registro.treinamentoId)?.cargaHoraria
        ?? registro.cargaHoraria,
      instrutor: '',
      conteudoProgramatico: this.treinamentos().find((item) => item.id === registro.treinamentoId)?.descricao
        ?? registro.conteudoProgramatico,
    };
    this.arquivoCertificado = null;
    this.selecionarAba('certificados');
  }

  iniciarInvalidacao(id: number): void {
    this.cicloParaInvalidarId = id;
    this.motivoInvalidacao = '';
    this.limparMensagens();
  }

  cancelarInvalidacao(): void {
    this.cicloParaInvalidarId = null;
    this.motivoInvalidacao = '';
  }

  forcarReciclagem(formulario: NgForm): void {
    if (!this.authService.isAdmin() || this.cicloParaInvalidarId === null || this.salvando) {
      return;
    }
    if (formulario.invalid || !this.motivoInvalidacao.trim()) {
      formulario.control.markAllAsTouched();
      return;
    }
    const id = this.cicloParaInvalidarId;
    const registroInvalidado = this.historico().find((registro) => registro.id === id);
    this.salvando = true;
    this.treinamentoService.invalidarCiclo(id, this.motivoInvalidacao.trim()).subscribe({
      next: () => {
        this.salvando = false;
        this.cancelarInvalidacao();
        this.carregarHistorico();
        if (registroInvalidado) {
          this.iniciarRenovacao(registroInvalidado);
        }
        this.mensagemSucesso = 'Certificado invalidado. Registre a nova conclusão para reiniciar o ciclo.';
      },
      error: (erro: HttpErrorResponse) => this.finalizarErro(erro, 'invalidar o certificado'),
    });
  }

  abrirCertificado(registro: HistoricoTreinamento): void {
    this.treinamentoService.baixarCertificado(registro.id).subscribe({
      next: (arquivo) => {
        const url = URL.createObjectURL(arquivo);
        const link = document.createElement('a');
        link.href = url;
        link.download = registro.certificadoNome;
        link.click();
        setTimeout(() => URL.revokeObjectURL(url), 1000);
      },
      error: (erro: HttpErrorResponse) => this.finalizarErro(erro, 'baixar o certificado'),
    });
  }

  abrirRegraGeral(treinamento: Treinamento): void {
    this.abaAtiva = 'validades';
    const existente = this.parametros().find(
      (parametro) => parametro.treinamentoId === treinamento.id && !parametro.cargo,
    );
    this.parametroEditandoId = existente?.id ?? null;
    this.parametroForm = {
      treinamentoId: treinamento.id,
      cargo: '',
      validadeMeses: existente?.validadeMeses ?? treinamento.validade,
      diasAntecedenciaAlerta: existente?.diasAntecedenciaAlerta ?? 60,
    };
  }

  novaRegraPorCargo(): void {
    this.parametroEditandoId = null;
    this.parametroForm = {
      treinamentoId: this.treinamentos()[0]?.id ?? 0,
      cargo: '',
      validadeMeses: 12,
      diasAntecedenciaAlerta: 60,
    };
  }

  editarParametro(parametro: ParametroTreinamento): void {
    this.parametroEditandoId = parametro.id;
    this.parametroForm = {
      treinamentoId: parametro.treinamentoId,
      cargo: parametro.cargo ?? '',
      validadeMeses: parametro.validadeMeses,
      diasAntecedenciaAlerta: parametro.diasAntecedenciaAlerta,
    };
  }

  salvarParametro(formulario: NgForm): void {
    if (!this.authService.isAdmin() || this.salvando) {
      return;
    }
    if (formulario.invalid || this.parametroForm.treinamentoId <= 0) {
      formulario.control.markAllAsTouched();
      this.mensagemErro = 'Selecione um treinamento e informe uma validade e antecedência válidas.';
      return;
    }
    this.salvando = true;
    this.limparMensagens();
    this.treinamentoService.salvarParametro(
      this.parametroForm.treinamentoId,
      {
        cargo: this.parametroForm.cargo.trim() || null,
        validadeMeses: Number(this.parametroForm.validadeMeses),
        diasAntecedenciaAlerta: Number(this.parametroForm.diasAntecedenciaAlerta),
      },
      this.parametroEditandoId ?? undefined,
    ).subscribe({
      next: (parametro) => {
        this.parametros.update((lista) => [
          ...lista.filter((item) => item.id !== parametro.id),
          parametro,
        ]);
        this.parametroEditandoId = parametro.id;
        this.parametroForm = {
          treinamentoId: parametro.treinamentoId,
          cargo: parametro.cargo ?? '',
          validadeMeses: parametro.validadeMeses,
          diasAntecedenciaAlerta: parametro.diasAntecedenciaAlerta,
        };
        this.mensagemSucesso = 'Regra de validade salva.';
        this.salvando = false;
      },
      error: (erro: HttpErrorResponse) => this.finalizarErro(erro, 'salvar a regra de validade'),
    });
  }

  excluirParametro(parametro: ParametroTreinamento): void {
    if (
      !this.authService.isAdmin() ||
      typeof window === 'undefined' ||
      !window.confirm(
        `Excluir a regra de ${parametro.norma} para ${parametro.cargo || 'todos os cargos'}? Os certificados já registrados manterão a validade aplicada no histórico.`,
      )
    ) {
      return;
    }

    this.salvando = true;
    this.limparMensagens();
    this.treinamentoService
      .excluirParametro(parametro.treinamentoId, parametro.id)
      .subscribe({
        next: () => {
          this.parametros.update((lista) =>
            lista.filter((item) => item.id !== parametro.id),
          );
          if (this.parametroEditandoId === parametro.id) {
            this.parametroEditandoId = null;
          }
          this.salvando = false;
          this.mensagemSucesso =
            'Regra excluída. Certificados já registrados mantêm a validade aplicada.';
        },
        error: (erro: HttpErrorResponse) => this.finalizarErro(erro, 'excluir a regra de validade'),
      });
  }

  statusLabel(status: StatusHistoricoTreinamento): string {
    const labels: Record<StatusHistoricoTreinamento, string> = {
      VALIDO: 'Válido',
      ALERTA: 'Em alerta / reciclagem',
      VENCIDO: 'Vencido',
      INVALIDADO: 'Invalidado',
      SUBSTITUIDO: 'Ciclo anterior',
    };
    return labels[status];
  }

  formatarData(data: string | null): string {
    if (!data) {
      return '—';
    }
    const [ano, mes, dia] = data.split('-');
    return `${dia}/${mes}/${ano}`;
  }

  private carregarTreinamentos(): void {
    this.treinamentoService.listar().subscribe({
      next: (dados) => this.treinamentos.set(dados),
      error: (erro: HttpErrorResponse) => this.definirErro(erro, 'carregar os treinamentos'),
    });
  }

  private carregarHistorico(): void {
    this.treinamentoService.listarHistorico().subscribe({
      next: (dados) => this.historico.set(dados),
      error: (erro: HttpErrorResponse) => this.definirErro(erro, 'carregar certificados e validades'),
    });
  }

  private carregarParametros(): void {
    this.treinamentoService.listarParametros().subscribe({
      next: (dados) => this.parametros.set(dados),
      error: (erro: HttpErrorResponse) => this.definirErro(erro, 'carregar as regras de validade'),
    });
  }

  private carregarColaboradores(): void {
    this.usuarioApiService.listar().subscribe({
      next: (usuarios) =>
        this.colaboradores.set(usuarios.filter((usuario) => usuario.perfil === 'colaborador')),
      error: (erro: HttpErrorResponse) => this.definirErro(erro, 'carregar os colaboradores'),
    });
  }

  private criarTreinamentoVazio(): Treinamento {
    return {
      id: 0,
      nome: '',
      norma: '',
      descricao: '',
      cargaHoraria: 0,
      validade: 0,
      participantes: 0,
      status: 'Ativo',
      usuarioIds: [],
    };
  }

  private conclusaoVazia(): RegistroConclusaoTreinamento {
    return {
      treinamentoId: 0,
      usuarioId: 0,
      dataConclusao: new Date().toISOString().slice(0, 10),
      cargaHoraria: 0,
      instrutor: '',
      conteudoProgramatico: '',
    };
  }

  private obterDadosTreinamento(): TreinamentoRequest {
    const { id: _id, ...dados } = this.novoTreinamento;
    return { ...dados, usuarioIds: this.novoTreinamento.usuarioIds ?? [] };
  }

  private finalizarErro(erro: HttpErrorResponse, acao: string): void {
    this.definirErro(erro, acao);
    this.salvando = false;
  }

  private definirErro(erro: HttpErrorResponse, acao: string): void {
    if (erro.status === 401) {
      this.mensagemErro = 'Sua sessão expirou ou é inválida. Entre novamente e tente outra vez.';
    } else if (erro.status === 403) {
      this.mensagemErro = 'Sua conta não tem permissão para executar esta ação.';
    } else if (erro.status === 413) {
      this.mensagemErro = 'O certificado excede o limite de 10 MB.';
    } else if (erro.status === 0) {
      this.mensagemErro = 'Não foi possível conectar à API de treinamentos.';
    } else if (erro.status === 400) {
      this.mensagemErro = erro.error?.detail ?? erro.error?.message
        ?? `A API rejeitou os dados ao ${acao}. Confira os campos e o arquivo anexado.`;
    } else {
      this.mensagemErro = `Não foi possível ${acao} (HTTP ${erro.status}).`;
    }
  }

  private limparMensagens(): void {
    this.mensagemErro = null;
    this.mensagemSucesso = null;
  }
}
