.history-table { width: 100%; min-width: 760px; border-collapse: collapse; }
.history-table thead { background: #f8f6f0; }
.history-table th { padding: 13px 15px; border-top: 1px solid #f0ede6; border-bottom: 1px solid #eae5db; color: #5e6571; font-size: .69rem; font-weight: 800; text-align: left; white-space: nowrap; }
.history-table td { padding: 13px 15px; border-bottom: 1px solid #f0ede6; color: #333b49; font-size: .74rem; vertical-align: middle; }
.history-table tbody tr:hover { background: #fdfbf6; }
.history-type { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; white-space: nowrap; }
.history-type i { display: grid; width: 28px; height: 28px; place-items: center; border-radius: 8px; background: #fbf1d5; color: #9c761d; font-size: .9rem; }
.history-progress { display: grid; grid-template-columns: 38px minmax(58px, 90px); align-items: center; gap: 9px; }
.history-progress strong { color: #343c49; font-size: .72rem; font-variant-numeric: tabular-nums; }
.progress-track { display: block; height: 6px; overflow: hidden; border-radius: 99px; background: #e8e7e1; }
.progress-track > span { display: block; height: 100%; border-radius: inherit; background: #399356; }
.progress-track > span.progress-warning { background: #dca32b; }
.icon-button { display: inline-grid; flex: 0 0 auto; width: 34px; height: 34px; place-items: center; border: 1px solid #e5dfd4; border-radius: 8px; background: #fff; color: #4b5360; cursor: pointer; transition: border-color 150ms ease, background 150ms ease, color 150ms ease; }
.icon-button:hover { border-color: #d7b64e; background: #fff9e8; color: #806113; }
.icon-button:focus-visible { outline: 3px solid rgba(242, 189, 53, .45); outline-offset: 2px; }
.record-origin { display: block; margin-top: 4px; color: #8a6a1e; font-size: .65rem; font-weight: 700; }
.feedback-message-error { border-color: #e5b6b4; background: #fff2f1; color: #9f302d; }

/* Seletor de tipo: cinco modelos previstos para a operação da Crisântemos */
.selector-screen { min-width: 0; padding: clamp(20px, 2.4vw, 32px); border: 1px solid #e8e2d8; border-radius: 16px; background: #fff; box-shadow: 0 5px 18px rgba(22, 31, 45, .025); }
.selector-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 18px; }
.selector-heading h1 { margin: 5px 0 0; color: #141b29; font-size: clamp(1.45rem, 2vw, 1.9rem); font-weight: 800; letter-spacing: -.04em; }
.selector-heading p { margin: 7px 0 0; color: #737b89; font-size: .86rem; line-height: 1.5; }
.inspection-type-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 14px; margin-top: 26px; }
.inspection-type-card { display: flex; flex-direction: column; align-items: center; min-width: 0; min-height: 205px; padding: 20px 14px 15px; border: 1px solid #e7e1d6; border-radius: 12px; background: #fffefa; color: #222a37; text-align: center; cursor: pointer; transition: border-color 160ms ease, background 160ms ease, transform 160ms ease, box-shadow 160ms ease; }
.inspection-type-card:hover { transform: translateY(-2px); border-color: #d9b33e; background: #fffdf7; box-shadow: 0 5px 15px rgba(45, 38, 15, .055); }
.inspection-type-card:focus-visible { outline: 3px solid rgba(242, 189, 53, .5); outline-offset: 2px; }
.inspection-type-icon { display: grid; width: 62px; height: 62px; flex: 0 0 auto; place-items: center; margin-bottom: 14px; border: 1px solid #f1e6c5; border-radius: 13px; background: #fff6dc; color: #9d7417; font-size: 1.65rem; }
.inspection-type-card strong { display: block; color: #1e2633; font-size: .78rem; font-weight: 800; line-height: 1.35; }
.inspection-type-card > span:not(.inspection-type-icon):not(.type-card-action) { display: block; margin-top: 9px; color: #707782; font-size: .71rem; line-height: 1.55; }
.type-card-action { display: inline-flex; align-items: center; gap: 6px; margin-top: auto; padding-top: 13px; color: #95701a; font-size: .68rem; font-weight: 800; }
.selector-footer { display: flex; align-items: center; justify-content: space-between; gap: 18px; margin-top: 25px; padding-top: 18px; border-top: 1px solid #efebe4; }
.selector-footer > span { color: #777e89; font-size: .73rem; line-height: 1.5; }
.breadcrumb { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; margin-bottom: 11px; color: #8b8f97; font-size: .7rem; }
.breadcrumb button { padding: 0; border: 0; background: transparent; color: #8a6a1e; font: inherit; cursor: pointer; }
.breadcrumb button:hover { color: #5d4510; text-decoration: underline; }
.breadcrumb i { font-size: .6rem; }
.issue-action { width: 30px; height: 30px; color: #8b6d1d; }

/* Responsividade */

@media (max-width: 1200px) {
  .stats-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .inspection-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .inspection-summary {
    min-height: 250px;
  }

  .summary-main {
    justify-content: flex-start;
    gap: clamp(25px, 7vw, 70px);
  }

  .stats-grid,
  .inspection-type-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (max-width: 760px) {
  .checklist-page {
    gap: 16px;
    padding: 14px;
  }

  .page-heading {
    align-items: stretch;
    flex-direction: column;
    gap: 16px;
  }

  .header-actions {
    justify-content: flex-start;
  }

  .header-actions .button {
    flex: 1 1 auto;
  }

  .stats-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .stat-card {
    gap: 10px;
    min-height: 90px;
    padding: 13px;
  }

  .stat-icon {
    flex-basis: 35px;
    width: 35px;
    height: 35px;
    font-size: 1rem;
  }

  .stat-number {
    font-size: 1.55rem;
  }

  .stat-label {
    font-size: 0.68rem;
  }

  .stat-card-progress {
    grid-column: 1 / -1;
  }

  .conformity-ring {
    width: 53px;
  }

  .conformity-ring::before {
    width: 41px;
  }

  .inspection-fields {
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
  }

  .field-group-full {
    grid-column: auto;
  }

  .summary-main {
    justify-content: space-between;
    gap: 16px;
  }

  .summary-counts {
    gap: 13px;
  }

  .verification-header {
    align-items: flex-start;
  }

  .verification-header h2 {
    font-size: 1.08rem;
  }

  .verification-legend {
    gap: 10px;
  }

  .verification-legend span {
    font-size: 0.67rem;
  }

  .category-heading {
    padding: 13px 11px;
  }

  .category-title {
    font-size: 0.75rem;
  }

  .category-count {
    display: none;
  }

  .observations-evidence-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .evidence-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .evidence-preview,
  .evidence-upload {
    min-height: 85px;
  }

  .checklist-actions {
    align-items: stretch;
    flex-direction: column-reverse;
  }

  .checklist-actions .button,
  .selector-footer .button {
    width: 100%;
  }

  .overview-heading,
  .detail-heading {
    align-items: center;
  }

  .history-heading {
    align-items: flex-start;
    padding: 17px 15px;
  }

  .inspection-type-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin-top: 19px;
  }

  .inspection-type-card {
    min-height: 190px;
    padding: 15px 10px 12px;
  }

  .inspection-type-icon {
    width: 52px;
    height: 52px;
    margin-bottom: 11px;
    font-size: 1.4rem;
  }

  .selector-footer {
    align-items: stretch;
    flex-direction: column;
  }

  .detail-heading .header-actions {
    justify-content: stretch;
  }

  .history-table td,
  .history-table th {
    padding-right: 11px;
    padding-left: 11px;
  }
}

@media (max-width: 400px) {
  .header-actions {
    align-items: stretch;
    flex-direction: column;
  }

  .header-actions .button {
    width: 100%;
  }

  .summary-ring {
    width: 96px;
  }

  .summary-ring-inner strong {
    font-size: 1.2rem;
  }

  .summary-count {
    gap: 7px;
  }

  .section-heading {
    gap: 10px;
  }

  .surface-card {
    padding: 15px;
  }

  .history-card {
    padding: 0;
  }

  .inspection-type-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .inspection-type-card {
    min-height: 165px;
  }

  .selector-screen {
    padding: 16px;
  }
}

/* Impressão */

@media print {
  :host,
  .checklist-page {
    background: #fff;
    color: #111;
  }

  .checklist-page {
    display: block;
    padding: 0;
  }

  .page-heading,
  .stats-grid,
  .inspection-grid,
  .verification-panel,
  .nonconformity-card,
  .observations-evidence-grid {
    margin-bottom: 16px;
  }

  .header-actions,
  .checklist-actions,
  .evidence-upload,
  .remove-evidence,
  .feedback-message,
  .selector-screen,
  .history-card .icon-button {
    display: none !important;
  }

  .surface-card,
  .verification-panel,
  .inspection-summary,
  .category-section {
    break-inside: avoid;
    box-shadow: none;
  }

  .verification-panel,
  .inspection-summary {
    print-color-adjust: exact;
    -webkit-print-color-adjust: exact;
  }

  .table-responsive {
    overflow: visible;
  }

  .verification-table,
  .issues-table {
    min-width: 0;
  }

  .verification-table th,
  .verification-table td,
  .issues-table th,
  .issues-table td {
    padding: 7px 5px;
    font-size: 9pt;
  }

  .category-section:not(:has(.verification-table)) {
    display: none;
  }

  input,
  select,
  textarea {
    color: #111 !important;
    print-color-adjust: exact;
  }
}
