<file path="src/app/services/auth.service.ts">
import { HttpClient } from '@angular/common/http';
import { Injectable } from '@angular/core';
import { Observable, tap } from 'rxjs';

export type Perfil = 'admin' | 'colaborador';

export interface LoginApiResponse {
  token: string;
  expiresIn: number;
  usuario: {
    id: number;
    nome: string;
    email: string;
    perfil: string;
    cargo: string | null;
    status: string;
  };
}

@Injectable({ providedIn: 'root' })
export class AuthService {
  private readonly apiUrl = 'http://localhost:8080/api/auth/login';

  constructor(private http: HttpClient) {}

  loginApi(email: string, senha: string): Observable<LoginApiResponse> {
    return this.http.post<LoginApiResponse>(this.apiUrl, { email, senha }).pipe(
      tap((resposta) => this.gravarSessao(resposta)),
    );
  }

  private gravarSessao(resposta: LoginApiResponse): void {
    if (typeof window === 'undefined') {
      return;
    }

    localStorage.setItem('accessToken', resposta.token);
    localStorage.setItem(
      'tokenExpiresAt',
      String(Date.now() + resposta.expiresIn * 1000),
    );
    localStorage.setItem('perfil', resposta.usuario.perfil.toLowerCase());
    localStorage.setItem('nomeUsuario', resposta.usuario.nome);
    localStorage.setItem('usuarioLogado', JSON.stringify(resposta.usuario));
    localStorage.removeItem('isLoggedIn');
  }

  logout(): void {
    if (typeof window === 'undefined') {
      return;
    }

    localStorage.removeItem('accessToken');
    localStorage.removeItem('tokenExpiresAt');
    localStorage.removeItem('perfil');
    localStorage.removeItem('nomeUsuario');
    localStorage.removeItem('usuarioLogado');
    localStorage.removeItem('isLoggedIn');
  }

  isAuthenticated(): boolean {
    if (typeof window === 'undefined') {
      return false;
    }

    const token = localStorage.getItem('accessToken');
    const expiresAt = Number(localStorage.getItem('tokenExpiresAt'));
    return Boolean(token && expiresAt > Date.now());
  }

  getPerfil(): Perfil | null {
    if (typeof window === 'undefined') {
      return null;
    }

    const perfil = localStorage.getItem('perfil');
    return perfil === 'admin' || perfil === 'colaborador' ? perfil : null;
  }

  isAdmin(): boolean {
    return this.getPerfil() === 'admin';
  }

  isColaborador(): boolean {
    return this.getPerfil() === 'colaborador';
  }

  getNomeUsuario(): string {
    if (typeof window === 'undefined') {
      return '';
    }

    return localStorage.getItem('nomeUsuario') ?? '';
  }

  getUsuarioLogado(): { nome: string; role: Perfil; email: string } | null {
    if (typeof window === 'undefined') {
      return null;
    }

    const usuarioSalvo = localStorage.getItem('usuarioLogado');
    if (!usuarioSalvo) {
      return null;
    }

    try {
      const usuario = JSON.parse(usuarioSalvo) as LoginApiResponse['usuario'];
      const perfil = usuario.perfil.toLowerCase();
      if (perfil !== 'admin' && perfil !== 'colaborador') {
        throw new Error(`Perfil de usuário não reconhecido: ${usuario.perfil}`);
      }

      return { nome: usuario.nome, email: usuario.email, role: perfil };
    } catch (erro) {
      console.error('Erro ao ler usuário autenticado:', erro);
      this.logout();
      return null;
    }
  }
}
</file>

<file path="src/app/services/Treinamento.service.ts">
import { Injectable, inject } from '@angular/core';
import { HttpClient } from '@angular/common/http';
import { map } from 'rxjs';
import {
  HistoricoTreinamento,
  ParametroTreinamento,
  ParametroTreinamentoRequest,
  RegistroConclusaoTreinamento,
  StatusTreinamento,
  Treinamento,
} from '../pages/treinamentos/treinamento.model';

export type TreinamentoRequest = Omit<Treinamento, 'id'>;

type StatusTreinamentoApi = 'ATIVO' | 'INATIVO' | 'PLANEJADO' | 'CONCLUIDO';
type TreinamentoApiRequest = Omit<TreinamentoRequest, 'status'> & {
  status: StatusTreinamentoApi;
};
type TreinamentoApiResponse = Omit<Treinamento, 'status'> & {
  status: StatusTreinamentoApi;
  usuarioIds: number[];
};

const statusParaApi: Record<StatusTreinamento, StatusTreinamentoApi> = {
  Ativo: 'ATIVO',
  Inativo: 'INATIVO',
  Planejado: 'PLANEJADO',
  'Concluído': 'CONCLUIDO',
};

const statusDaApi: Record<StatusTreinamentoApi, StatusTreinamento> = {
  ATIVO: 'Ativo',
  INATIVO: 'Inativo',
  PLANEJADO: 'Planejado',
  CONCLUIDO: 'Concluído',
};

@Injectable({ providedIn: 'root' })
export class TreinamentoService {
  private http = inject(HttpClient);
  private url = 'http://localhost:8080/api/treinamentos';

  listar() {
    return this.http.get<TreinamentoApiResponse[]>(this.url).pipe(
      map((treinamentos) =>
        treinamentos.map((treinamento) => ({
          ...treinamento,
          status: statusDaApi[treinamento.status],
        })),
      ),
    );
  }

  criar(dados: TreinamentoRequest) {
    return this.http.post<TreinamentoApiResponse>(this.url, this.paraApi(dados)).pipe(
      map((treinamento) => ({
        ...treinamento,
        status: statusDaApi[treinamento.status],
      })),
    );
  }

  atualizar(id: number, dados: TreinamentoRequest) {
    return this.http.put<TreinamentoApiResponse>(
      `${this.url}/${id}`,
      this.paraApi(dados),
    ).pipe(
      map((treinamento: TreinamentoApiResponse) => ({
        ...treinamento,
        status: statusDaApi[treinamento.status],
      })),
    );
  }

  listarHistorico() {
    return this.http.get<HistoricoTreinamento[]>(`${this.url}/historico`);
  }

  registrarConclusao(dados: RegistroConclusaoTreinamento, certificado: File) {
    const formulario = new FormData();
    formulario.append(
      'dados',
      new Blob([JSON.stringify(dados)], { type: 'application/json' }),
    );
    formulario.append('certificado', certificado, certificado.name);
    return this.http.post<HistoricoTreinamento>(`${this.url}/historico`, formulario);
  }

  invalidarCiclo(id: number, motivo: string) {
    return this.http.post<HistoricoTreinamento>(`${this.url}/historico/${id}/invalidar`, {
      motivo,
    });
  }

  baixarCertificado(id: number) {
    return this.http.get(`${this.url}/historico/${id}/certificado`, {
      responseType: 'blob',
    });
  }

  listarParametros() {
    return this.http.get<ParametroTreinamento[]>(`${this.url}/parametros`);
  }

  salvarParametro(
    treinamentoId: number,
    dados: ParametroTreinamentoRequest,
    parametroId?: number,
  ) {
    return parametroId === undefined
      ? this.http.post<ParametroTreinamento>(
          `${this.url}/${treinamentoId}/parametros`,
          dados,
        )
      : this.http.put<ParametroTreinamento>(
          `${this.url}/${treinamentoId}/parametros/${parametroId}`,
          dados,
        );
  }

  excluirParametro(treinamentoId: number, parametroId: number) {
    return this.http.delete<void>(
      `${this.url}/${treinamentoId}/parametros/${parametroId}`,
    );
  }

  private paraApi(dados: TreinamentoRequest): TreinamentoApiRequest {
    return {
      ...dados,
      status: statusParaApi[dados.status],
    };
  }
}
</file>

