<file path="src/app/pages/usuarios/usuarios.html">
<div class="conteudo-pagina">
  <header class="app-page-heading">
    <div class="app-page-heading__content">
      <span class="app-page-heading__eyebrow"><i class="bi bi-shield-check"></i> SAÚDE E SEGURANÇA DO TRABALHO</span>
      <h1 class="app-page-heading__title">Usuários</h1>
      <p class="app-page-heading__description">Gerencie os usuários e os níveis de acesso ao sistema.</p>
    </div>
  </header>

  <nav class="sub-nav" aria-label="Navegação de usuários">
    <button
      type="button"
      [class.active]="subNavAtiva === 'lista'"
      (click)="mostrarUsuarios()"
    >
      Usuários cadastrados
    </button>
    <button
      *ngIf="authService.isAdmin()"
      type="button"
      [class.active]="subNavAtiva === 'cadastro'"
      (click)="abrirCadastro()"
    >
      Registrar novo usuário
    </button>
  </nav>

  <section *ngIf="subNavAtiva === 'cadastro' && authService.isAdmin()" class="registro-form">
    <h3>Registrar novo usuário</h3>
    <form #formCadastro="ngForm" (ngSubmit)="cadastrarUsuario(formCadastro)">
      <div class="form-grid">
        <div class="form-group">
          <label for="novo-nome">Nome completo</label>
          <input id="novo-nome" name="nome" [(ngModel)]="novoUsuario.nome" required />
        </div>

        <div class="form-group">
          <label for="novo-usuario">E-mail</label>
          <input id="novo-usuario" type="email" name="email" [(ngModel)]="novoUsuario.email"
            autocomplete="email" required />
          <small>Use um endereço válido, por exemplo nome@empresa.com.</small>
        </div>

        <div class="form-group">
          <label for="novo-cargo">Cargo</label>
          <input id="novo-cargo" name="cargo" [(ngModel)]="novoUsuario.cargo" required />
        </div>

        <div class="form-group">
          <label for="novo-perfil">Perfil de acesso</label>
          <select id="novo-perfil" name="perfil" [(ngModel)]="novoUsuario.perfil" required>
            <option value="colaborador">Colaborador</option>
            <option value="admin">Administrador</option>
          </select>
        </div>

        <div class="form-group">
          <label for="nova-senha">Senha</label>
          <input id="nova-senha" type="password" name="senha" [(ngModel)]="novoUsuario.senha"
            autocomplete="new-password" minlength="6" required />
          <small>A senha deve ter pelo menos 6 caracteres.</small>
        </div>

      </div>

      <div class="form-actions">
        <button type="submit">Registrar usuário</button>
        <button type="button" class="cancel-button" (click)="cancelarCadastro()">Cancelar</button>
      </div>
    </form>
  </section>

  <div class="acoes" *ngIf="subNavAtiva === 'lista'">
    <input
      type="text"
      placeholder="Buscar usuário"
      [(ngModel)]="termoBusca"
      (keyup.enter)="buscarUsuario()"
    />
    <button type="button" (click)="buscarUsuario()">Buscar Usuário</button>
  </div>

  <section *ngIf="mensagem" class="mensagem-alerta">
    {{ mensagem }}
  </section>

  <table *ngIf="subNavAtiva === 'lista'">
    <thead>
      <tr>
        <th>Nome</th>
        <th>Cargo</th>
        <th>Perfil</th>
        <th>Status</th>
        <th>Ações</th>
      </tr>
    </thead>

    <tbody>
      <tr *ngFor="let usuario of usuariosFiltrados">
        <td>{{ usuario.nome }}</td>
        <td>{{ usuario.cargo }}</td>
        <td>{{ usuario.perfil }}</td>
        <td>{{ usuario.ativo ? 'Ativo' : 'Inativo' }}</td>
        <td>
          <button
            type="button"
            (click)="visualizarUsuario(usuario)"
          >
            Ver
          </button>

          <button
            *ngIf="authService.isAdmin() || usuario.nome === authService.getUsuarioLogado()?.nome"
            type="button"
            (click)="editarUsuario(usuario)"
          >
            Editar
          </button>
        </td>
      </tr>
      <tr *ngIf="usuariosFiltrados.length === 0">
        <td colspan="5">Nenhum usuário encontrado.</td>
      </tr>
    </tbody>
  </table>

  <section *ngIf="usuarioVisualizado" class="view-form">
    <h3>Gestão de Riscos de {{ usuarioVisualizado.nome }}</h3>
    <div class="detalhes-usuario">
      <p><strong>Cargo:</strong> {{ usuarioVisualizado.cargo }}</p>
      <p><strong>Perfil:</strong> {{ usuarioVisualizado.perfil }}</p>
      <p><strong>Status do usuário:</strong> {{ usuarioVisualizado.ativo ? 'Ativo' : 'Inativo' }}</p>
    </div>

    <h4>Riscos associados</h4>
    <p *ngIf="riscosCarregando" role="status">Carregando associações...</p>
    <p *ngIf="riscosMensagem" class="mensagem-alerta" role="status">{{ riscosMensagem }}</p>

    <div *ngIf="authService.isAdmin()" class="associar-risco">
      <div class="form-group">
        <label for="risco-usuario">Risco</label>
        <select id="risco-usuario" name="riscoUsuario" [(ngModel)]="riscoSelecionadoId">
          <option [ngValue]="null">Selecione um risco ativo</option>
          <option *ngFor="let risco of riscosDisponiveis" [ngValue]="risco.id">
            {{ risco.setor }} — {{ risco.risco }}
          </option>
        </select>
      </div>
      <div class="form-group">
        <label for="validade-risco">Validade</label>
        <input id="validade-risco" name="validadeRisco" type="date" [(ngModel)]="novaValidade" />
      </div>
      <label class="checkbox-group">
        <input type="checkbox" name="novoRiscoValidado" [(ngModel)]="novoRiscoValidado" />
        Validado
      </label>
      <button type="button" (click)="adicionarRiscoAoUsuario()">Adicionar risco</button>
    </div>

    <table class="riscos-table" *ngIf="!riscosCarregando">
      <thead>
        <tr>
          <th>Setor</th>
          <th>Risco</th>
          <th>Nível</th>
          <th>Situação</th>
          <th>Validade</th>
          <th>Validado</th>
          <th>Validade vigente</th>
          <th *ngIf="authService.isAdmin()">Ações</th>
        </tr>
      </thead>
      <tbody>
        <tr *ngFor="let risco of usuarioVisualizado.riscos">
          <td>{{ risco.setor }}</td>
          <td>{{ risco.risco }}</td>
          <td>{{ risco.nivel }}</td>
          <td>{{ risco.situacao }}</td>
          <td>
            <input *ngIf="authService.isAdmin()" type="date"
              [name]="'validade-' + risco.riscoId" [(ngModel)]="risco.validade" />
            <span *ngIf="!authService.isAdmin()">{{ risco.validade | date:'dd/MM/yyyy' }}</span>
          </td>
          <td>
            <input *ngIf="authService.isAdmin()" type="checkbox"
              [name]="'validado-' + risco.riscoId" [(ngModel)]="risco.validado" />
            <span *ngIf="!authService.isAdmin()">{{ risco.validado ? 'Sim' : 'Não' }}</span>
          </td>
          <td>{{ risco.validadeValida ? 'Sim' : 'Não' }}</td>
          <td *ngIf="authService.isAdmin()">
            <button type="button" class="cancel-button"
              (click)="removerRiscoDoUsuario(risco.riscoId)">Remover</button>
          </td>
        </tr>
        <tr *ngIf="usuarioVisualizado.riscos.length === 0">
          <td [attr.colspan]="authService.isAdmin() ? 8 : 7">Nenhum risco associado a este usuário.</td>
        </tr>
      </tbody>
    </table>

    <div *ngIf="authService.isAdmin()" class="edit-actions">
      <button type="button" [disabled]="salvandoRiscos || riscosCarregando"
        (click)="salvarAssociacoesRisco()">
        {{ salvandoRiscos ? 'Salvando...' : 'Salvar associações' }}
      </button>
    </div>
    <button type="button" class="close-view" (click)="usuarioVisualizado = null">Fechar</button>
  </section>

  <section *ngIf="usuarioSelecionado" class="edit-form">
    <h3>Editar usuário</h3>
    <div class="form-group">
      <label>Nome</label>
      <input type="text" [(ngModel)]="usuarioSelecionado.nome" />
    </div>
    <div class="form-group">
      <label>Cargo</label>
      <input type="text" [(ngModel)]="usuarioSelecionado.cargo" />
    </div>
    <div class="form-group">
      <label>Perfil</label>
      <input type="text" [(ngModel)]="usuarioSelecionado.perfil" />
    </div>
    <div class="form-group status-group">
      <label>Status</label>
      <select [(ngModel)]="usuarioSelecionado.ativo">
        <option [ngValue]="true">Ativo</option>
        <option [ngValue]="false">Inativo</option>
      </select>
    </div>

    <div class="edit-actions">
      <button type="button" (click)="salvarEdicao()">Salvar</button>
      <button type="button" class="cancel-button" (click)="cancelarEdicao()">Cancelar</button>
    </div>
  </section>
</div>
</file>

