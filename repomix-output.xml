export type StatusHistoricoTreinamento =
  | 'VALIDO'
  | 'ALERTA'
  | 'VENCIDO'
  | 'INVALIDADO'
  | 'SUBSTITUIDO';

export interface HistoricoTreinamento {
  id: number;
  treinamentoId: number;
  treinamentoNome: string;
  norma: string;
  usuarioId: number;
  colaboradorNome: string;
