  observacoes: string | null;
  epi: string;
  quantidade: number;
  dataValidade: string;
  ca: string;
  remessas: Array<{ remessaId: number; quantidade: number; dataValidade: string }>;
  itens: Array<{ nome: string; quantidade: number }>;
}

export interface EntregaEpiRequestApi {
  funcionarioId: number;
  dataEntrega: string;
  observacoes: string;
