    Write-Error "Node não encontrado em $nodeDir. Verifique se a pasta existe."
    exit 1
}

$env:Path = "$nodeDir;$env:Path"

Write-Host "Usando Node local: $nodeDir"
& "$nodeDir\node.exe" -v
& "$nodeDir\npm.cmd" -v
& "$nodeDir\npx.cmd" --yes ng serve
</file>

<file path="run-node.cmd">
