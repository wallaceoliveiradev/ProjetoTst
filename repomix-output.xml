<file path="src/app/pages/riscos/riscos.scss">
.riscos-page {
  display: grid;
  gap: 28px;
  padding: 24px;
  font-family: 'Inter', sans-serif;
  color: #1c1c1c;
  background: #f5f6f8;
}

.novo-risco {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: #c28300;
  color: white;
  padding: 14px 20px;
  border: none;
  border-radius: 14px;
  cursor: pointer;
  font-weight: 700;
}

.riscos-summary {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
}

.riscos-summary article {
  display: flex;
  gap: 16px;
  align-items: center;
  background: white;
  border-radius: 20px;
  padding: 22px;
  box-shadow: 0 18px 40px rgba(15, 23, 42, 0.08);
}

.summary-icon {
  width: 52px;
  height: 52px;
  border-radius: 16px;
  display: grid;
  place-items: center;
  color: white;
}

.summary-warning {
  background: #f7e3c8;
  color: #b98309;
}

.summary-danger {
  background: #fee2e2;
  color: #b91c1c;
}

.summary-medium {
  background: #fef3c7;
  color: #b45309;
}

.summary-success {
  background: #dcfce7;
  color: #15803d;
}

.riscos-summary article strong {
  display: block;
  margin-bottom: 4px;
  font-size: 0.95rem;
}

.riscos-summary article span {
  display: block;
  font-size: 1.75rem;
  font-weight: 700;
  margin: 4px 0;
}

.riscos-summary article p {
  margin: 0;
  color: #6b7280;
}

.riscos-filter {
  display: grid;
  gap: 18px;
  background: white;
  padding: 22px;
  border-radius: 22px;
  box-shadow: 0 18px 40px rgba(15, 23, 42, 0.06);
}

.search-input {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 14px 18px;
  border: 1px solid #e5e7eb;
  border-radius: 18px;
  background: #f8fafc;
}

.search-input i {
  color: #6b7280;
}

.search-input input {
  border: none;
  background: transparent;
  width: 100%;
  padding: 10px 0;
  outline: none;
}

.filter-controls {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
  align-items: end;
}

.filter-group {
  display: grid;
  gap: 8px;
}

.filter-group label {
  color: #4b5563;
  font-weight: 600;
}

.filter-group select {
  border: 1px solid #e5e7eb;
  border-radius: 14px;
  padding: 14px 16px;
  background: white;
}

.filter-actions {
  display: flex;
  gap: 12px;
}

.btn-filter,
.btn-clear {
  border: none;
  margin: 0;
  padding: 14px 20px;
  border-radius: 14px;
  font-weight: 700;
  cursor: pointer;
}

.btn-filter {
  background: #b98309;
  color: white;
}

.btn-clear {
  background: transparent;
  color: #b98309;
  border: 1px solid #b98309;
}

.riscos-table-card {
  overflow: hidden;
  border-radius: 24px;
  box-shadow: 0 18px 40px rgba(15, 23, 42, 0.08);
}

.riscos-table-card table {
  width: 100%;
  border-collapse: collapse;
  background: white;
}

.riscos-table-card th,
.riscos-table-card td {
  padding: 18px 20px;
  border-bottom: 1px solid #e5e7eb;
}

.riscos-table-card thead {
  background: #111827;
  color: white;
}

.riscos-table-card tbody tr:last-child td {
  border-bottom: none;
}

.setor-cell {
  display: flex;
  align-items: center;
  gap: 12px;
}

.setor-icon {
  width: 42px;
  height: 42px;
  border-radius: 14px;
  display: grid;
  place-items: center;
  background: #f8fafc;
  color: #b98309;
}

.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  padding: 8px 12px;
  font-size: 0.85rem;
  font-weight: 700;
}

.nivel-alto {
  background: #fee2e2;
  color: #b91c1c;
}

.nivel-médio {
  background: #fef3c7;
  color: #b45309;
}

.nivel-baixo {
  background: #dcfce7;
  color: #15803d;
}

.status {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  border-radius: 999px;
  padding: 8px 12px;
  font-weight: 700;
}

.status.ativo {
  background: #dcfce7;
  color: #15803d;
}

.status.inativo {
  background: #fee2e2;
  color: #b91c1c;
}

.actions-cell {
  display: flex;
  gap: 10px;
  justify-content: flex-end;
}

.action-btn {
  width: 42px;
  height: 42px;
  border: 1px solid #e5e7eb;
  border-radius: 14px;
  background: white;
  display: grid;
  place-items: center;
  color: #4b5563;
  cursor: pointer;
}

.action-btn.view {
  color: #b98309;
  border-color: #f3d27a;
}

.action-btn.edit {
  color: #2563eb;
  border-color: #bfdbfe;
}

.action-btn.more {
  color: #9ca3af;
}

.riscos-message {
  padding: 12px 16px;
  border-radius: 12px;
  background: #fff;
}

.riscos-message.error {
  border: 1px solid #fecaca;
  color: #991b1b;
}

.riscos-message.success {
  border: 1px solid #bbf7d0;
  color: #166534;
}

.risco-form-card {
  display: grid;
  gap: 18px;
  padding: 22px;
  border: 1px solid #e5e7eb;
  border-radius: 22px;
  background: #fff;
  box-shadow: 0 18px 40px rgba(15, 23, 42, 0.06);
}

.risco-form-card h2 {
  margin: 0;
  font-size: 1.25rem;
}

.risco-form-card p {
  margin: 8px 0 0;
}

.risco-form-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 16px;
  margin-bottom: 18px;
}

.risco-form-grid input,
.risco-form-grid select {
  box-sizing: border-box;
  width: 100%;
  padding: 12px 14px;
  border: 1px solid #e5e7eb;
  border-radius: 14px;
  background: #fff;
}

.risco-form-card .filter-actions {
  justify-content: flex-start;
}

.risco-form-card button:disabled {
  cursor: not-allowed;
  opacity: 0.65;
}

